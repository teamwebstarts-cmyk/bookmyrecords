# ==========================================
# Book My Records — Production Environment Config
# ==========================================

# ---- Runtime ----
PORT=8765
NODE_ENV=production

# ---- Database (MongoDB Atlas) ----
# Set your MongoDB Atlas connection string here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bookmyrecords

# ---- Admin Dashboard Security ----
# Password to access /admin.html
ADMIN_PASSWORD=adminPass2026!
ADMIN_TOKEN=adminPass2026!

# ---- AI Engine (DeepSeek / OpenAI Compatible) ----
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_PROVIDER=deepseek-compatible
AI_API_KEY=replace-with-your-live-key
AI_MOCK_MODE=false

# ---- Consultation Booking (Cal.com) ----
CAL_EVENT_SLUG=your-team/business-health-consultation
CAL_WEBHOOK_SECRET=replace-with-cal-webhook-secret

# ---- Storage Mode ----
# With MongoDB URI set, MongoDB is automatically used for submissions & PDF storage
STORAGE_ENABLED=true
STORAGE_DRIVER=mongodb
PDF_OUTPUT_DIR=storage/reports

# ---- Owner Alerts (Optional Resend/Email) ----
RESEND_API_KEY=optional-resend-key
OWNER_EMAIL=info@bookmyrecords.com
